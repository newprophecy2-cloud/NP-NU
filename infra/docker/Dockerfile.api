FROM node:22-alpine AS base
WORKDIR /app

COPY package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/schemas/package.json packages/schemas/
COPY apps/api/package.json apps/api/

RUN npm install --workspace=packages/shared --workspace=packages/schemas --workspace=apps/api --include-workspace-root --ignore-scripts \
 && npm install --no-save typescript@^5.7.3

COPY packages/shared packages/shared
COPY packages/schemas packages/schemas
COPY apps/api apps/api

RUN npm --workspace=packages/shared run build \
 && npm --workspace=packages/schemas run build \
 && npm --workspace=apps/api run build

ENV NODE_ENV=production
EXPOSE 4000
CMD ["sh", "-c", "node apps/api/dist/db/migrate.js && node apps/api/dist/db/seed.js && node apps/api/dist/server.js"]
