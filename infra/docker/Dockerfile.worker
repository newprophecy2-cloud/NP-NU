FROM node:22-alpine AS base
WORKDIR /app

COPY package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/schemas/package.json packages/schemas/
COPY workers/scraper/package.json workers/scraper/

RUN npm install --workspace=packages/shared --workspace=packages/schemas --workspace=workers/scraper --include-workspace-root --ignore-scripts \
 && npm install --no-save typescript@^5.7.3

COPY packages/shared packages/shared
COPY packages/schemas packages/schemas
COPY workers/scraper workers/scraper

RUN npm --workspace=packages/shared run build \
 && npm --workspace=packages/schemas run build \
 && npm --workspace=workers/scraper run build

ENV NODE_ENV=production
CMD ["node", "workers/scraper/dist/worker.js"]
