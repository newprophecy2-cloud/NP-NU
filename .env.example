# Application
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL
DATABASE_URL=postgresql://npnu:npnu_dev_password@localhost:5432/npnu

# Redis
REDIS_URL=redis://localhost:6379

# Security & Sessions (replace with 32+ char random secrets in production)
SESSION_SECRET=change-me-in-production-min-32-chars-session
AUTH_SECRET=change-me-in-production-min-32-chars-auth
COOKIE_SECURE=false

# Scraper
SCRAPER_ENABLED=true
SCRAPER_USER_AGENT=NP-NU-Bot/1.0 (+https://github.com/newprophecy2-cloud/NP-NU)
SCRAPER_REQUEST_TIMEOUT_MS=12000
SCRAPER_MAX_CONCURRENCY=2
SCRAPER_MIN_DELAY_MS=1500
DOCUMENT_STORAGE_PATH=./storage/documents
LOG_LEVEL=info
